{
  "manifestVersion": 5,
  "id": "com.speechify.speechenhancer",
  "name": "Veyra",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "speechify.panel",
      "label": {
        "default": "Veyra"
      },
      "minimumSize": {
        "width": 300,
        "height": 450
      },
      "maximumSize": {
        "width": 800,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 600
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765",
        "http://localhost:8765",
        "https://huggingface.co",
        "https://github.com"
      ]
    },
    "clipboard": "readAndWrite",
    "localFileSystem": "fullAccess"
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon-23.png",
      "scale": [1, 2],
      "theme": ["light", "darkest"]
    }
  ]
}
